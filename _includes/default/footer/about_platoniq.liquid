<section class="d-flex flex-lg-row flex-column justify-content-center justify-content-lg-between p-5 border-bottom hr-light">
  <div class="d-flex flex-column col">
    <div class="d-flex flex-row">
      {% include default/links/nav_links.liquid links='footer_links' fw='fw-bold' %}  
    </div>
    <div class="d-flex flex-row justify-content-lg-start justify-content-center mt-3">
      {% include default/socials.liquid %}
    </div>
  </div>

  <div class="d-flex flex-row col sponsor-div">
    <div class="d-flex align-items-center flex-column flex-lg-row mt-4 mb-4 m-lg-0">
      <img src="/media/site-symbols/FUE.png" alt="FUE" loading="lazy" class="w-50">
      <img src="/media/site-symbols/PRTR.png" alt="PRTR"  oading="lazy">
    </div>
  </div>

  <div class="d-flex flex-row justify-content-center col">
    <div class="d-flex flex-column">
      <a href="https://goteo.org" target="_blank" class="d-flex justify-content-center">
        <img src="/media/site-symbols/logo_goteo.webp" alt="goteo" class="w-50" loading="lazy">
      </a>
    </div>
    <div class="d-flex flex-column">
      <a href="https://platoniq.net" target="_blank" class="d-flex justify-content-center m-auto">
        <img src="/media/site-symbols/Platoniq_logo.webp" alt="Platoniq" class="w-50" loading="lazy">
      </a>
    </div>
  </div>
</section>
