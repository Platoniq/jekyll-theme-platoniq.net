
<div class="d-flex flex-column justify-content-between pe-4 ps-4 pb-5 author-img col-lg-4">
  <div class="position-relative">
    <img src="{{ person.image.path }}" alt="{{ person.image.alt }}" class="w-100" style="height: 24rem; object-fit: cover;" loading="lazy">
    <img src="{{ site.data[locale].global.project_img_decorator.path }}" 
         alt="{{ site.data[locale].global.project_img_decorator.path }}"
         class="author-img-decorator" loading="lazy">
  </div>
  <div class="d-flex flex-column pt-2 justify-content-top flex-fill">
    <h3 class="who-name">{{ person.title }}</h3>
    <span class="who-position-label">{{ person.position }}</span>
    <span class="who-description">{{ person.description }}</span>
    <span class="pt-2">{{ person.email }}</span>
  </div>
  <div> <!-- hide of no social media -->
    <hr class="hr me-lg-3"></hr>
    <div>
      <span class="socials">
        {% include default/member-socials.liquid %}
      </span> 
    </div>
  </div>
</div>
