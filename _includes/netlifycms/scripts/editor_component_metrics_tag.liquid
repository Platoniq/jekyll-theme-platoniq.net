{% raw %}

CMS.registerEditorComponent({
  id: "metrics-tag",
  label: "Metrics",
  fields: [
    {
      name: 'items',
      label: 'Items',
      widget: 'list',
      summary: '{{fields.label}}: {{fields.number}}',
      fields: [
        {
          name: 'number',
          label: 'Number',
          widget: 'string'
        },
        {
          name: 'text',
          label: 'Text',
          widget: 'string'
        }
      ]
    },
  ],
  pattern: /{% metrics { "items": (.*) } %}/,
  fromBlock: function(match) {

    const items = JSON.parse(match[1]);
    
    return { items };
  },
  toBlock: function(data) {
    const items = data.items || [];

    return `{% metrics { "items": ${JSON.stringify(items)} } %}`
  },
  toPreview: function(data) {
    return  `
      <section class="pj-metrics row d-flex flex-column flex-lg-row justify-content-lg-between mt-4 mb-5">
        {% for item in data.items %}
          <div class="d-flex justify-content-start flex-column">
            <div class="metrics__number text-center">
              <h3>{{ item.number }}</h3>
            </div>
            <div class="metrics__text w-100 w-lg-auto text-center p-2">
              <p class="m-0 overflow">{{ item.text }}</p>
              <span onclick="seeMore(this)"><i class='fa-solid fa-plus'></i></span>
            </div>
          </div>
        {% endfor %}
    </section>
     `
  }
});
{% endraw %}

