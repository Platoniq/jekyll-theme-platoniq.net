{% raw %}
  - name: services
    label: Services
    label_singular: Service
    folder: "_services"
    i18n:
      structure: multiple_folders
      locales: *locales
    create: true
    editor:
      preview: false
    fields:
      - label: Layout
        name: layout
        widget: hidden
        default: service
        i18n: duplicate

      - label: Slug
        name: slug
        hint: "Identificador único, compartido entre los distintos idiomas"
        widget: string
        i18n: duplicate

      - label: Título
        name: title
        widget: string
        i18n: translate

      - label: Descripción
        name: description
        widget: markdown
        i18n: translate

      - label: Image
        name: image
        widget: object
        i18n: true
        fields:
          - label: Imagen
            name: path
            widget: image
            choose_url: false
            default: "/media/projects/photo-1452745872182-022042dead8f.jpg"
            media_library: { config: { multiple: false } }
            media_folder: "/media/services"
            i18n: duplicate
          - label: Texto alternativo a la imagen
            name: alt
            widget: string
            i18n: translate

      - label: Contenido de la página
        name: body
        widget: markdown
        i18n: true

      - label: Colaboradores
        name: collaborators
        widget: relation
        collection: collaborators
        search_fields: [title]
        value_field: slug
        multiple: true
        i18n: duplicate

      - label: Call To Action
        name: call_to_action 
        widget: object
        i18n: true
        fields:
          - label: Imagen
            name: image_path
            widget: image
            choose_url: false
            default: "/media/site-symbols/info.png"
            media_library: { config: { multiple: false } }
            media_folder: "/media/services"
            i18n: duplicate
          - label: Texto alternativo a la imagen
            name: image_alt 
            widget: string
            i18n: translate
          - label: Text
            name: text
            widget: string
            i18n: translate
          - label: Url
            name: url
            widget: string
            i18n: duplicate
          - label: Url Text
            name: url_text
            i18n: translate
{% endraw %}
